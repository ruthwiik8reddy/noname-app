# systemd unit for BayQ. Install:
#   sudo cp deploy/bayq.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bayq
# Assumes the app lives in /opt/bayq, owned by a dedicated `bayq` user, with
# its virtualenv in /opt/bayq/.venv and settings in /opt/bayq/.env.

[Unit]
Description=BayQ detailing studio app (gunicorn)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=bayq
Group=bayq
WorkingDirectory=/opt/bayq
EnvironmentFile=/opt/bayq/.env
ExecStart=/opt/bayq/.venv/bin/gunicorn -c gunicorn.conf.py run:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=40

# Hardening: the app only needs to write its data, uploads and logs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bayq/data /opt/bayq/logs
UMask=0027

[Install]
WantedBy=multi-user.target
