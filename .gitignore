# Secrets — never commit. Copy .env.example to .env and fill it in.
.env
.env.*
!.env.example

# Databases and backups (contain customer data and password hashes)
*.db
*.db.bak
*.db-wal
*.db-shm
*.db.*.lock
*.sqlite3
backups/

