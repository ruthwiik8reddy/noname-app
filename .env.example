# Copy to .env and fill in. Never commit .env.
# Check everything with:  python -m src.manage check

# ── App ──────────────────────────────────────────────────────────────
# production turns on secure cookies, HSTS and the startup safety checks.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_DEBUG=0
# 1 = load the three demo studios into an empty database (never in production)
SEED_DEMO=0

# Public address customers see in tracking and approval links (https in production)
APP_BASE_URL=http://localhost:5055
# Number of reverse proxies in front of the app (1 behind nginx, 0 when run directly)
TRUSTED_PROXIES=0

# ── Storage ──────────────────────────────────────────────────────────
# Defaults: studios.db and private_uploads/ in the project folder.
# DATABASE_URL=/opt/bayq/data/bayq.db
# PRIVATE_UPLOAD_ROOT=/opt/bayq/data/private

# ── Web server (gunicorn.conf.py) ────────────────────────────────────
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# GUNICORN_BIND=127.0.0.1:8000

# ── Local AI (Ollama) ────────────────────────────────────────────────
# AI_ENABLED=0 runs every AI feature on its built-in fallback instead.
AI_ENABLED=1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Must be a vision model you have pulled: ollama pull qwen2.5vl:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# AI calls allowed at once per gunicorn worker. Total = this × GUNICORN_WORKERS;
# keep that within what your Ollama server can run in parallel.
LLM_MAX_CONCURRENT=1
# 0 turns off the background agents (stock, leads, estimates…)
AGENT_SCHEDULER=1

# ── Messaging defaults ───────────────────────────────────────────────
# Country code for WhatsApp links when a studio hasn't set one (91 = India)
DEFAULT_COUNTRY_CODE=91
# Platform Twilio account (each studio can add its own under Settings)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Login protection ─────────────────────────────────────────────────
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
